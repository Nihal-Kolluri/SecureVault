    "express": "^4.21.2",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "minio": "^8.0.7",
    "otplib": "^13.5.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
